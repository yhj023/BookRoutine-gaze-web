{
  "name": "gaze-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/copy-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "compare:ops": "python -I scripts/compare/py_ops_fixture.py",
    "compare:py": "python -I scripts/compare/py_extract.py",
    "compare:gaze": "python -I scripts/compare/py_gaze.py",
    "analyze:calib": "vite-node scripts/analyze-calib.ts"
  },
  "dependencies": {
    "@litertjs/core": "2.6.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "3.2.4"
  }
}
